# Gemini AI (required for AI assistant feature)
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini model to use (default shown)
GEMINI_MODEL=gemma-4-31b-it

# Kroki diagram rendering service
# For local dev: http://localhost:8000 (Docker)
# For Vercel: https://kroki.io (public instance) or your own deployment
KROKI_URL=https://kroki.io

# Ollama (optional local AI fallback — not usable on Vercel)
OLLAMA_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:2b

# Client-side encryption secret (baked into the JS bundle at build time via Vite).
# Used to derive the AES-256-GCM key that encrypts API keys in localStorage.
# Generate a strong random value for production deployments.
VITE_ENCRYPTION_SECRET=change-me-in-production
