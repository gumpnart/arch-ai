{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist-server",
    "paths": {}
  },
  "include": ["src/**/*", "server/**/*"],
  "exclude": ["node_modules", "dist", "dist-server"]
}
